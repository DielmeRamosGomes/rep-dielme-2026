# 1. Imagem base oficial do Python (versão slim, leve)
FROM python:3.11-slim

# 2. Define o diretório de trabalho dentro do container
WORKDIR /app

# 3. Copia o arquivo de dependências
COPY requirements.txt .

# 4. Instala as dependências sem armazenar cache desnecessário
RUN pip install --no-cache-dir -r requirements.txt

# 5. Copia o código da aplicação
COPY . .

# 6. Informa a porta que o Flask utiliza
EXPOSE 5000

# 7. Comando para rodar a aplicação quando o container iniciar
CMD ["python", "app.py"]

